{
  "name": "obsidian-screen-wake-lock",
  "version": "1.3.0",
  "description": "enables a wake lock if in edit mode",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "npx eslint ."
  },
  "keywords": [
    "obsidian",
    "plugin",
    "wake-lock"
  ],
  "author": "blotspot",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "@types/dom-screen-wake-lock": "^1.0.3",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "latest",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "tslib": "2.4.0"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 120,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": [
          "src/**/*.ts"
        ],
        "options": {
          "tabWidth": 2
        }
      }
    ]
  }
}
